<title>Deal Compare 3 Kênh</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: sticky header + tab bar; mỗi tab = KPI strip → filter bar → bảng cuộn ngang */
:root{
  --bg:#f6f7f9;--panel:#fff;--fg:#17202b;--mute:#5e6b7a;--line:#e1e5ea;--soft:#eef1f5;
  --accent:#c2185b;--scom:#c2185b;--shp:#e4572e;--tts:#0f8b8d;
  --good:#1d7a46;--goodbg:#e3f3e9;--warn:#9a6200;--warnbg:#fdf1d8;--bad:#b3261e;--badbg:#fbe4e2;
  --f-text:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-num:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0f141a;--panel:#161d25;--fg:#e6ebf1;--mute:#93a1b1;--line:#28323d;--soft:#1d2630;
  --accent:#f06292;--scom:#f06292;--shp:#ff8a65;--tts:#4dd0c8;
  --good:#6fd39b;--goodbg:#173326;--warn:#f2c46b;--warnbg:#3a2e14;--bad:#ff8a80;--badbg:#3d1c1a;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f141a;--panel:#161d25;--fg:#e6ebf1;--mute:#93a1b1;--line:#28323d;--soft:#1d2630;
  --accent:#f06292;--scom:#f06292;--shp:#ff8a65;--tts:#4dd0c8;
  --good:#6fd39b;--goodbg:#173326;--warn:#f2c46b;--warnbg:#3a2e14;--bad:#ff8a80;--badbg:#3d1c1a;color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--f-text);font-size:14px;line-height:1.45}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--panel)}
.wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--panel);border-bottom:1px solid var(--line)}
.hd{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding-block:12px 0}
h1{font-size:19px;margin:0;font-weight:700;text-wrap:balance}
.sub{color:var(--mute);font-size:12px}
.tabs{display:flex;gap:4px;overflow-x:auto;padding-top:8px}
.tab{border:0;background:none;color:var(--mute);font:600 14px var(--f-text);padding:8px 14px;border-bottom:3px solid transparent;cursor:pointer;white-space:nowrap}
.tab[aria-selected="true"]{color:var(--fg);border-color:var(--c,var(--accent))}
.tab:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{border:0;background:var(--panel);color:var(--mute);font:500 12px var(--f-text);padding:6px 10px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--fg);color:var(--panel)}
main{padding-block:16px 40px;display:grid;gap:14px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.kpi b{display:block;font:600 22px var(--f-num);font-variant-numeric:tabular-nums}
.kpi span{color:var(--mute);font-size:12px}
.bod{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:10px;padding:12px 14px}
.bod h3{margin:0 0 6px;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--mute)}
.bod ul{margin:0;padding-left:18px;display:grid;gap:3px}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.bar input[type=search],.bar select{font:13px var(--f-text);color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 10px;min-width:0}
.bar input[type=search]{flex:1 1 220px}
.bar label{display:inline-flex;gap:6px;align-items:center;font-size:13px;color:var(--mute);cursor:pointer}
.btn{font:600 12px var(--f-text);border:1px solid var(--line);background:var(--panel);color:var(--fg);border-radius:8px;padding:7px 12px;cursor:pointer}
.tw{background:var(--panel);border:1px solid var(--line);border-radius:10px;overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px}
th{position:sticky;top:0;background:var(--soft);text-align:left;font-weight:600;font-size:12px;color:var(--mute);padding:8px;white-space:nowrap;cursor:pointer;user-select:none}
th[data-k=""]{cursor:default}
th.s::after{content:" ▾"}th.s.asc::after{content:" ▴"}
td{padding:7px 8px;border-top:1px solid var(--line);vertical-align:top}
td.n{font-family:var(--f-num);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
td.p{max-width:440px;min-width:300px}
.nm{font-weight:500}
.pf{white-space:normal;min-width:120px}
.gf{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.mt{color:var(--mute);font-size:11.5px}
.code{font-family:var(--f-num);font-size:11px}
.pill{display:inline-block;font:600 11px var(--f-text);padding:2px 8px;border-radius:99px;white-space:nowrap}
.t-TOP{background:var(--goodbg);color:var(--good)}.t-NÊN{background:var(--soft);color:var(--fg)}
.t-THEO{background:var(--warnbg);color:var(--warn)}.t-KHÔNG{background:var(--badbg);color:var(--bad)}
.best{background:var(--goodbg);color:var(--good);font-weight:600}
.lose{color:var(--bad);font-weight:600}
.warn{color:var(--warn);cursor:help}
.ch{font:600 11px var(--f-text);padding:1px 6px;border-radius:4px;color:var(--panel)}
.ch-SCOM{background:var(--scom)}.ch-SHP{background:var(--shp)}.ch-TTS{background:var(--tts)}
.pg{display:flex;gap:8px;align-items:center;justify-content:flex-end;color:var(--mute);font-size:12px}
details{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:13px}
details summary{cursor:pointer;font-weight:600}
details p,details li{max-width:80ch;color:var(--mute)}
.toast{position:fixed;right:max(16px,env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--fg);color:var(--panel);padding:8px 14px;border-radius:8px;font-size:13px}
.scorebar{display:inline-block;width:46px;height:6px;background:var(--soft);border-radius:3px;vertical-align:middle;margin-left:6px;overflow:hidden}
.scorebar i{display:block;height:100%;background:var(--c,var(--accent))}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
